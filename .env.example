# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://llmops:llmops_secret@localhost:5432/llmops_db

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application ───────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000

# ── Canary / A-B Testing ──────────────────────────────────
CANARY_WEIGHT=0.1
ENABLE_AB_TESTING=false

# ── Cost Tracking ─────────────────────────────────────────
COST_TRACKING_ENABLED=true
COST_ALERT_THRESHOLD_USD=50.00

# ── Evaluation ─────────────────────────────────────────────
EVAL_ON_PUSH=true
EVAL_SAMPLE_SIZE=50
